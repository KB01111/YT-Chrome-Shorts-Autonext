{
  "manifest_version": 3,
  "name": "Shorts AutoNext — Efficient",
  "version": "1.0.0",
  "description": "Automatically advances to the next YouTube Short when one ends. Event-driven, zero polling, minimal CPU.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorts AutoNext"
  },
  "commands": {
    "toggle-autonext": {
      "suggested_key": {
        "default": "Shift+D"
      },
      "description": "Toggle auto-scroll on/off"
    },
    "like-toggle": {
      "suggested_key": {
        "default": "Shift+G"
      },
      "description": "Toggle like on current Short"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
